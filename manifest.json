{
  "manifest_version": 3,
  "name": "Formmate - Smart Autofill",
  "version": "1.0.0",
  "description": "Formmate fills the current page with related English sample data for practical form testing.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "commands": {
    "fill-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Fill empty fields on the current page"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Formmate",
    "default_popup": "popup.html"
  }
}
